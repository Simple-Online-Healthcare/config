{
  "name": "soh-config",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for shared TypeScript, Prettier, and ESLint configs.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "packages:list": "lerna list",
    "release": "changeset publish",
    "lint": "lerna run lint --stream --no-private",
    "test": "lerna run test --stream --no-private",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "lerna": "8.2.4"
  }
}
